# Leave blank for a safe preview with menu placeholders and no inquiry storage.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only. Never use a NEXT_PUBLIC_ prefix for this key.
SUPABASE_SECRET_KEY=
# Only enable after running the migration and setting up spam protection.
INQUIRIES_ENABLED=false
# Long random server-only string used to hash IP addresses for the rate limit.
INQUIRY_RATE_LIMIT_SALT=
# Required when inquiries are enabled. Use your exact deployment origin.
SITE_URL=http://localhost:3000
# Keep true until real business details and photographs have been approved.
PREVIEW_MODE=true
